# =============================================================================
# DevCatalyst Hub — Environment Configuration Template
# =============================================================================
# Copy this file to `.env.local` to configure your connection to InsForge.
#
# SECURITY MANDATE:
# NEVER place service_role keys, database passwords, or administrative tokens
# in this file or any file prefixed with VITE_. All VITE_ variables are bundled
# directly into client-side JavaScript and are publicly readable in browsers.
# =============================================================================

# 1. InsForge Backend Endpoint
# Local development server or remote InsForge cloud project URL
# e.g., http://localhost:7130 or https://<project-id>.insforge.app
VITE_INSFORGE_URL=http://localhost:7130

# 2. InsForge Anonymous / Public Client Key
# This is the public API key with Row-Level Security applied.
# It is safe for browser-side inclusion.
VITE_INSFORGE_ANON_KEY=your-insforge-anon-key-here

# 3. Application Metadata (Optional)
VITE_APP_NAME="DevCatalyst Hub"
